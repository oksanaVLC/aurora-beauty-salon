# URL de la aplicación web de Google Apps Script (termina en /exec). OBLIGATORIA:
# las reservas funcionan solo con Google Sheets y `npm run build` falla si está vacía.
PUBLIC_BOOKING_API_URL=

# Enlace que abre el botón «Iniciar sesión» del header.
# Con la opción Google Sheets, pon aquí la URL de la hoja de cálculo del salón.
PUBLIC_ADMIN_URL=
