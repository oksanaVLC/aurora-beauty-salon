---
import Logo from './Logo.astro';
import type { Lang } from '../lib/booking-core';
import { useTranslations, localePath } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<footer class="bg-mint site-footer">
  <div class="container">
    <a href={`${localePath(lang, '/')}#inicio`} class="brand" style="gap: 16px">
      <Logo id="f" size={48} />
      <span class="brand-text"><span class="brand-name">AURORA</span><span class="brand-sub" style="margin-top: 7px">Beauty Salon</span></span>
    </a>
    <nav aria-label={t('footer.label')}>
      <a href={localePath(lang, '/aviso-legal')}>{t('footer.legal')}</a>
      <a href={localePath(lang, '/privacidad')}>{t('footer.privacy')}</a>
      <a href={localePath(lang, '/cookies')}>{t('footer.cookies')}</a>
      <a data-salon-href="instagram" data-salon-optional="instagram" hidden target="_blank" rel="noopener">Instagram</a>
    </nav>
  </div>
</footer>
