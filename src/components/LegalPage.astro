---
/** Página legal (aviso legal, privacidad o cookies) en el idioma indicado. Textos en src/data/legal.ts. */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import BookingModal from './BookingModal.astro';
import FloatingBook from './FloatingBook.astro';
import type { Lang } from '../lib/booking-core';
import { localePath } from '../i18n/ui';
import { legal, legalUi, legalUpdated, type LegalSlug } from '../data/legal';
interface Props { lang: Lang; slug: LegalSlug }
const { lang, slug } = Astro.props;
const doc = legal[lang][slug];
const ui = legalUi[lang];
const others = (Object.keys(legal[lang]) as LegalSlug[]).filter((s) => s !== slug);

// Marcadores {dato} → <span data-salon="dato">, que src/lib/site-data.ts rellena con la hoja.
const OPTIONAL = ['cif', 'registry', 'email'];
const split = (text: string) => text.split(/(\{\w+\})/).filter(Boolean).map((p) => {
  const m = p.match(/^\{(\w+)\}$/);
  return m ? { key: m[1] } : { text: p };
});
const tokens = (text: string) => [...text.matchAll(/\{(\w+)\}/g)].map((m) => m[1]);
const optionalOf = (text: string) => tokens(text).find((k) => OPTIONAL.includes(k));
const hasTokens = (body: (string | string[])[]) => body.flat().some((x) => tokens(x).length);
---
<Base lang={lang} path={`/${slug}`} titleSalon={doc.title} description={doc.intro}>
  <Header lang={lang} path={`/${slug}`} home={false} />
  <main class="legal-wrap">
    <article class="container legal">
      <a class="legal-back" href={localePath(lang, '/')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M20 12H4M10 6l-6 6 6 6"></path></svg>
        {ui.back}
      </a>
      <h1 data-reveal>{doc.title}</h1>
      <p class="legal-updated" data-reveal style="--rd: .1s">{ui.updated}: {legalUpdated[lang]}</p>
      <p class="data-status" data-data-status></p>
      <p class="legal-intro" data-reveal style="--rd: .2s">{doc.intro}</p>
      {doc.sections.map((sec) => (
        <section data-reveal="fade" {...(hasTokens(sec.body) ? { 'data-needs-data': '', hidden: true } : {})}>
          <h2>{sec.h}</h2>
          {sec.body.map((b) => (Array.isArray(b)
            ? <ul>{b.map((li) => (
                <li data-salon-optional={optionalOf(li)}>{split(li).map((x) => 'key' in x ? <span data-salon={x.key}></span> : x.text)}</li>
              ))}</ul>
            : <p>{split(b).map((x) => 'key' in x ? <span data-salon={x.key}></span> : x.text)}</p>))}
        </section>
      ))}
      <nav class="legal-other" aria-label={ui.other}>
        <span>{ui.other}:</span>
        {others.map((s) => <a href={localePath(lang, `/${s}`)}>{legal[lang][s].title}</a>)}
      </nav>
    </article>
  </main>
  <Footer lang={lang} />
  <FloatingBook lang={lang} />
  <BookingModal lang={lang} />
</Base>

<style is:global>
  .legal-wrap { background: var(--grey-bg); padding: clamp(48px, 7vw, 96px) 0 clamp(72px, 9vw, 120px); }
  .legal { max-width: 860px; display: flex; flex-direction: column; gap: 18px; }
  .legal-back { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; font-size: 15px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; color: var(--green-ink); }
  .legal h1 { margin: 12px 0 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(44px, 6vw, 76px); line-height: 1; }
  .legal-updated { margin: 0; font-size: 15px; color: var(--muted); letter-spacing: 0.04em; }
  .legal-intro { margin: 8px 0 12px; font-size: 21px; line-height: 1.6; color: var(--ink-soft); }
  .legal section { padding: 24px 0 4px; border-top: 1px solid var(--line); }
  .legal h2 { margin: 0 0 12px; font-family: var(--font-display); font-weight: 400; font-size: clamp(26px, 3vw, 34px); line-height: 1.1; }
  .legal p, .legal li { font-size: 18px; line-height: 1.7; color: var(--ink); overflow-wrap: anywhere; }
  .legal p { margin: 0 0 12px; }
  .legal ul { margin: 0 0 12px; padding-left: 22px; }
  .legal li { margin-bottom: 6px; }
  .legal-other { display: flex; flex-wrap: wrap; gap: 10px 22px; padding-top: 28px; border-top: 1px solid var(--line); font-size: 16px; color: var(--muted); }
  .legal-other a { color: var(--green-ink); }
</style>
