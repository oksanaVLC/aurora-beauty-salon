---
interface Props { size?: number; id: string }
const { size = 44, id } = Astro.props;
---
<svg class="brand-mark" width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={`nacre-${id}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFFFFF"></stop><stop offset="1" stop-color="#FFFFFF" stop-opacity="0.8"></stop></linearGradient>
    <radialGradient id={`pearl-${id}`} cx="0.35" cy="0.3" r="0.8"><stop offset="0" stop-color="#FFFFFF"></stop><stop offset="0.6" stop-color="#EDE7EE"></stop><stop offset="1" stop-color="#CFC6D3"></stop></radialGradient>
  </defs>
  <g stroke={`url(#nacre-${id})`} stroke-width="2.4" fill="none"><path d="M6 46 V26 A18 18 0 0 1 42 26 V46"></path><path d="M11 46 V26 A13 13 0 0 1 37 26 V46"></path><path d="M16 46 V26 A8 8 0 0 1 32 26 V46"></path></g>
  <circle cx="24" cy="26" r="4" fill={`url(#pearl-${id})`} stroke="#CFC6D3" stroke-width="0.6"></circle>
</svg>
