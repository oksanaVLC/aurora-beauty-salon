---
import Logo from './Logo.astro';
import type { Lang } from '../lib/booking-core';
import { useTranslations, languages, localePath } from '../i18n/ui';

interface Props { lang: Lang; path?: string; home?: boolean }
const { lang, path = '/', home = true } = Astro.props;
const t = useTranslations(lang);
const adminUrl = import.meta.env.PUBLIC_ADMIN_URL || '#';
const base = home ? '' : localePath(lang, '/');
---
<div class="bg-mint">
  <header class="container site-header">
    <a href={home ? '#inicio' : localePath(lang, '/')} class="brand">
      <Logo id="h" size={44} />
      <span class="brand-text"><span class="brand-name">AURORA</span><span class="brand-sub">Beauty Salon</span></span>
    </a>
    <nav aria-label={t('nav.label')} class="main-nav" id="main-nav" data-nav>
      <a class="link" href={`${base}#servicios`}>{t('nav.services')}</a>
      <a class="link" href={`${base}#nosotros`}>{t('nav.salon')}</a>
      <a class="link" href={`${base}#contacto`}>{t('nav.contact')}</a>
      <label class="pill" style="padding: 0 10px 0 14px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"></path></svg>
        <span class="sr-only">{t('nav.language')}</span>
        <select data-lang-switch>
          {(Object.keys(languages) as Lang[]).map((l) => (
            <option value={localePath(l, path)} selected={l === lang}>{languages[l]}</option>
          ))}
        </select>
      </label>
      <a class="pill" href={adminUrl} target={adminUrl === '#' ? undefined : '_blank'} rel="noopener" aria-label={t('nav.login')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1-4 4-6 8-6s7 2 8 6"></path></svg>
        <span class="login-label">{t('nav.login')}</span>
      </a>
      <button type="button" class="btn-header nav-book" data-book>{t('nav.book')}</button>
    </nav>
    <div class="header-actions">
      <button type="button" class="btn-header header-book" data-book>{t('nav.book')}</button>
      <button type="button" class="nav-toggle" aria-controls="main-nav" aria-expanded="false" aria-label={t('nav.open')} data-label-open={t('nav.open')} data-label-close={t('nav.close')} data-nav-toggle>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </header>
</div>
<script>
  document.querySelectorAll<HTMLSelectElement>('[data-lang-switch]').forEach((sel) => {
    sel.addEventListener('change', () => { window.location.href = sel.value + window.location.search; });
  });

  // Menú móvil: el botón abre/cierra el panel; se cierra al elegir un enlace, con Escape o al tocar fuera.
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) || '');
    };
    const isOpen = () => nav.classList.contains('is-open');
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a, [data-book]')) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (isOpen() && !nav.contains(target) && !toggle.contains(target)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) { setOpen(false); toggle.focus(); }
    });
    window.matchMedia('(min-width: 1101px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }
</script>
