---
/** Botón «Reservar» flotante, siempre visible (como el típico botón de WhatsApp). Abre el modal de reservas. */
import type { Lang } from '../lib/booking-core';
import { useTranslations } from '../i18n/ui';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<button type="button" class="fab-book" data-book aria-label={t('nav.book')}>
  <span class="fab-ring" aria-hidden="true"></span>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3.5" y="5" width="17" height="15.5" rx="3"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path><path d="M9.2 15.2l2 2 3.8-4"></path>
  </svg>
  <span class="fab-label">{t('promo.cta')}</span>
</button>

<style>
  .fab-book {
    position: fixed; right: max(18px, env(safe-area-inset-right)); bottom: max(18px, env(safe-area-inset-bottom)); z-index: 60;
    display: inline-flex; align-items: center; gap: 10px; min-height: 60px; padding: 0 24px 0 18px; border-radius: 999px; cursor: pointer;
    font: inherit; font-size: 16px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green-deep);
    border: 1px solid rgba(255,255,255,0.95); background-image: var(--mint);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.85), inset 0 -4px 10px rgba(40,120,110,0.18), 0 16px 34px -12px rgba(30,90,80,0.6);
    transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease;
    animation: fab-in .7s cubic-bezier(.2,.8,.2,1) 1.4s both;
  }
  .fab-book:hover { transform: translateY(-3px) scale(1.03); box-shadow: inset 0 1px 0 rgba(255,255,255,0.85), 0 22px 40px -12px rgba(30,90,80,0.7); }
  .fab-book svg { position: relative; flex-shrink: 0; }
  .fab-label { position: relative; white-space: nowrap; }
  .fab-ring { position: absolute; inset: 0; border-radius: inherit; border: 2px solid rgb(120, 214, 180); animation: fab-pulse 2.6s ease-out 2.2s infinite; pointer-events: none; }
  @keyframes fab-in { from { opacity: 0; transform: translateY(24px) scale(.9); } to { opacity: 1; transform: none; } }
  @keyframes fab-pulse { 0% { opacity: .8; transform: scale(1); } 70%, 100% { opacity: 0; transform: scale(1.25, 1.5); } }
  @media (max-width: 480px) {
    .fab-book { min-height: 56px; padding: 0 20px 0 16px; font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) { .fab-book, .fab-ring { animation: none; } }
</style>
