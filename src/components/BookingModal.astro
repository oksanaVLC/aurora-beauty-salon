---
/**
 * Motor de reservas: modal de 5 pasos (servicio → profesional → fecha y hora → datos → confirmación).
 * Se abre con cualquier elemento que tenga el atributo `data-book`
 * (opcional `data-service="id"` para entrar con un servicio ya elegido).
 */
import type { Lang } from '../lib/booking-core';
import { ui, localePath } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const config = { lang, dict: ui[lang], citaPath: localePath(lang, '/cita'), privacyPath: localePath(lang, '/privacidad') };
---
<dialog id="booking" class="bk-dialog" aria-labelledby="bk-title">
  <div class="bk-modal">
    <div class="bk-watermark" aria-hidden="true">
      <svg width="76" height="76" viewBox="0 0 48 48" fill="none"><defs><linearGradient id="wmG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="rgb(182, 242, 196)"></stop><stop offset="0.35" stop-color="rgb(143, 233, 196)"></stop><stop offset="0.7" stop-color="rgb(140, 224, 224)"></stop><stop offset="1" stop-color="rgb(191, 234, 252)"></stop></linearGradient></defs><g stroke="url(#wmG)" stroke-width="2.4"><path d="M6 46 V26 A18 18 0 0 1 42 26 V46"></path><path d="M11 46 V26 A13 13 0 0 1 37 26 V46"></path><path d="M16 46 V26 A8 8 0 0 1 32 26 V46"></path></g><circle cx="24" cy="26" r="3.4" fill="url(#wmG)"></circle></svg>
      <span>AURORA</span>
    </div>
    <button type="button" class="bk-close" data-bk-close aria-label={ui[lang]['modal.close']}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <h2 id="bk-title" class="bk-title">{ui[lang]['modal.title']}</h2>
    <ol class="bk-steps" data-bk-steps aria-label="Pasos"></ol>
    <div class="bk-body" data-bk-body aria-live="polite"></div>
    <div class="bk-foot" data-bk-foot></div>
  </div>
</dialog>
<script type="application/json" id="bk-config" set:html={JSON.stringify(config)}></script>

<script>
  import { getCatalog, getBookableDays, getSlots, book, ApiError } from '../lib/booking-api';
  import { reloadSiteData, telHref, mapsQuery } from '../lib/site-data';
  import { staffFor, nowInSalon, weekday, type Booking, type Catalog, type Lang, type Slot } from '../lib/booking-core';
  import { formatDateLong, formatDayParts, downloadIcs, esc } from '../lib/format';

  const cfg = JSON.parse(document.getElementById('bk-config')!.textContent!) as {
    lang: Lang; dict: Record<string, string>; citaPath: string; privacyPath: string;
  };
  const L = cfg.lang;
  const t = (k: string, vars: Record<string, string | number> = {}) =>
    Object.entries(vars).reduce((s, [a, b]) => s.replace(`{${a}}`, String(b)), cfg.dict[k] ?? k);

  const dialog = document.getElementById('booking') as HTMLDialogElement;
  const elSteps = dialog.querySelector<HTMLElement>('[data-bk-steps]')!;
  const elBody = dialog.querySelector<HTMLElement>('[data-bk-body]')!;
  const elFoot = dialog.querySelector<HTMLElement>('[data-bk-foot]')!;

  interface State {
    step: number;
    serviceId: string;
    staffId: string; // 'any' o id
    days: string[];
    month: string; // mes que enseña el calendario, YYYY-MM
    date: string;
    slots: Slot[];
    loadingSlots: boolean;
    time: string;
    form: { name: string; email: string; phone: string; notes: string; privacy: boolean };
    errors: Record<string, string>;
    alert: string;
    sending: boolean;
    booking: Booking | null;
    loadingCat: boolean;
    fatal: string; // no se pudo leer la hoja: se muestra el error y no se puede reservar
    slotsError: string;
  }

  let cat: Catalog;
  let S: State = fresh();

  function fresh(): State {
    return {
      step: 0, serviceId: '', staffId: 'any', days: [], month: '', date: '', slots: [], loadingSlots: false, time: '',
      form: { name: '', email: '', phone: '', notes: '', privacy: false }, errors: {}, alert: '', sending: false, booking: null,
      loadingCat: false, fatal: '', slotsError: ''
    };
  }

  const services = () => cat.services.filter((s) => s.visible);
  const service = () => cat.services.find((s) => s.id === S.serviceId)!;
  const staffName = (id: string | null) => cat.staff.find((s) => s.id === id)?.name ?? '';

  /** Mensaje real según el tipo de error (sin conexión, Google tarda, hoja ocupada, error del servidor…). */
  function errMsg(err: unknown): string {
    const kind = err instanceof ApiError ? err.kind : 'network';
    console.error(err);
    return t(`err.${kind}`);
  }
  /** Teléfono del salón (de la hoja). Si la hoja no ha cargado no lo tenemos: no se muestra el botón de llamar. */
  const tel = () => (cat ? telHref(cat.salon.phone) : '');

  /* ------------------------------------------------------------ abrir / cerrar */

  let pendingService: string | undefined;
  async function open(serviceId?: string) {
    pendingService = serviceId;
    S = fresh();
    S.loadingCat = true;
    render();
    if (!dialog.open) dialog.showModal();
    document.documentElement.style.overflow = 'hidden';
    try {
      cat = await getCatalog();
      reloadSiteData(); // por si las secciones de la página habían fallado antes: usan la misma carga
    } catch (err) {
      S.loadingCat = false;
      S.fatal = errMsg(err);
      render();
      return;
    }
    S.loadingCat = false;
    const list = services();
    S.serviceId = serviceId && list.some((s) => s.id === serviceId) ? serviceId : list[0]?.id ?? '';
    if (serviceId && S.serviceId === serviceId) S.step = 1;
    render();
  }
  function close() { dialog.close(); }
  dialog.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); }); // clic fuera
  dialog.querySelector('[data-bk-close]')!.addEventListener('click', close);

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-book]');
    if (!trigger || dialog.contains(trigger)) return;
    e.preventDefault();
    open(trigger.dataset.service);
  });
  document.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    if ((e.key === 'Enter' || e.key === ' ') && el.matches('[data-book][role="button"]')) { e.preventDefault(); open(el.dataset.service); }
  });
  if (new URLSearchParams(location.search).has('reservar')) open(new URLSearchParams(location.search).get('reservar') || undefined);

  /* ------------------------------------------------------------ navegación */

  async function goTo(step: number) {
    S.step = step;
    S.alert = '';
    if (step === 2) await loadDays();
    render();
    elBody.scrollTop = 0;
  }

  async function loadDays() {
    try {
      S.days = await getBookableDays(S.serviceId, S.staffId);
    } catch (err) {
      S.days = []; S.date = ''; S.slots = []; S.slotsError = errMsg(err);
      return;
    }
    if (!S.days.includes(S.date)) { S.date = S.days[0] ?? ''; S.time = ''; }
    S.month = (S.date || nowInSalon().date).slice(0, 7);
    await loadSlots();
  }

  async function loadSlots() {
    if (!S.date) { S.slots = []; return; }
    S.loadingSlots = true;
    S.slotsError = '';
    render();
    try {
      S.slots = await getSlots(S.serviceId, S.staffId, S.date);
    } catch (err) {
      S.slots = [];
      S.slotsError = errMsg(err); // nunca «no quedan huecos» si en realidad no hemos podido consultarlos
    }
    S.loadingSlots = false;
    if (!S.slots.some((s) => s.time === S.time && s.staffId)) S.time = '';
    render();
  }

  function validate(): boolean {
    const f = S.form;
    const e: Record<string, string> = {};
    if (!f.name.trim()) e.name = t('modal.err.required');
    if (!f.email.trim()) e.email = t('modal.err.required');
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(f.email.trim())) e.email = t('modal.err.email');
    if (!f.phone.trim()) e.phone = t('modal.err.required');
    else if (f.phone.replace(/\D/g, '').length < 9) e.phone = t('modal.err.phone');
    if (!f.privacy) e.privacy = t('modal.err.privacy');
    S.errors = e;
    return !Object.keys(e).length;
  }

  async function submit() {
    readForm();
    if (!validate()) { render(); focusFirstError(); return; }
    S.sending = true; S.alert = '';
    render();
    const res = await book({
      serviceId: S.serviceId, staffId: S.staffId, date: S.date, time: S.time,
      name: S.form.name.trim(), email: S.form.email.trim(), phone: S.form.phone.trim(), notes: S.form.notes.trim(), lang: L
    });
    S.sending = false;
    if (res.ok) {
      S.booking = res.booking;
      S.step = 4;
      render();
      return;
    }
    if (res.error === 'slot_taken') {
      S.step = 2;
      S.time = '';
      await loadSlots();
      S.alert = t('modal.err.taken');
    } else if (res.error === 'unknown') {
      S.alert = t('modal.err.unknown');
    } else if (res.error === 'invalid') {
      S.alert = t('modal.err.invalid');
    } else {
      S.alert = t(`err.${res.error}`);
    }
    render();
  }

  function readForm() {
    const q = (n: string) => elBody.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${n}"]`);
    if (!q('name')) return;
    S.form = {
      name: q('name')!.value, email: q('email')!.value, phone: q('phone')!.value, notes: q('notes')!.value,
      privacy: (q('privacy') as HTMLInputElement).checked
    };
  }
  function focusFirstError() {
    const first = Object.keys(S.errors)[0];
    elBody.querySelector<HTMLElement>(`[name="${first}"]`)?.focus();
  }

  /* ------------------------------------------------------------ eventos (delegados) */

  elBody.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
    if (!b || (b as HTMLButtonElement).disabled) return;
    const v = b.dataset.val!;
    switch (b.dataset.act) {
      case 'service': S.serviceId = v; S.staffId = 'any'; render(); break;
      case 'any': S.staffId = 'any'; await goTo(2); break;
      case 'staff': S.staffId = S.staffId === v ? 'any' : v; render(); break;
      case 'day': S.date = v; S.time = ''; S.alert = ''; await loadSlots(); refocus(`[data-act="day"][data-val="${v}"]`); break;
      case 'month': S.month = shiftMonth(S.month, Number(v)); render(); refocus(`[data-act="month"][data-val="${v}"]:not(:disabled)`) || refocus('.bk-cal-day:not(:disabled)'); break;
      case 'time': S.time = v; S.alert = ''; render(); break;
      case 'ics': downloadIcs(S.booking!, service(), cat.salon.name, mapsQuery(cat), L); break;
      case 'retry-open': await open(pendingService); break;
      case 'retry-slots': if (S.date) await loadSlots(); else { await loadDays(); render(); } break;
    }
  });

  /** Tras volver a pintar, devuelve el foco al mismo botón (para teclado y lectores de pantalla). */
  function refocus(selector: string): boolean {
    const el = elBody.querySelector<HTMLElement>(selector);
    el?.focus({ preventScroll: true });
    return !!el;
  }

  /** Calendario con teclado: flechas = ±1 día / ±1 semana (salta los días no disponibles), Inicio/Fin = primer/último día del mes. */
  elBody.addEventListener('keydown', (e) => {
    const cur = (e.target as HTMLElement).closest<HTMLButtonElement>('.bk-cal-day');
    if (!cur) return;
    const all = [...elBody.querySelectorAll<HTMLButtonElement>('.bk-cal-day')];
    const enabled = all.filter((b) => !b.disabled);
    const i = all.indexOf(cur);
    let target: HTMLButtonElement | undefined;
    const step = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 7, ArrowUp: -7 }[e.key];
    if (step) {
      for (let j = i + step; j >= 0 && j < all.length; j += step) if (!all[j].disabled) { target = all[j]; break; }
    } else if (e.key === 'Home') target = enabled[0];
    else if (e.key === 'End') target = enabled[enabled.length - 1];
    else return;
    e.preventDefault();
    target?.focus();
  });
  elBody.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name && S.errors[el.name]) {
      delete S.errors[el.name];
      el.closest('.bk-field')?.classList.remove('has-error');
      el.closest('.bk-field')?.querySelector('.bk-err')?.remove();
    }
  });

  elFoot.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-nav]');
    if (!b || (b as HTMLButtonElement).disabled) return;
    const nav = b.dataset.nav;
    if (nav === 'back') { readForm(); await goTo(Math.max(0, S.step - 1)); }
    if (nav === 'next') {
      if (S.step === 2 && !S.time) { S.alert = t('modal.date.pick'); render(); return; }
      await goTo(S.step + 1);
    }
    if (nav === 'confirm') await submit();
    if (nav === 'close') close();
  });

  /* ------------------------------------------------------------ render */

  function render() {
    const labels = ['modal.step.service', 'modal.step.staff', 'modal.step.date', 'modal.step.data', 'modal.step.done'];
    elSteps.innerHTML = labels.map((k, i) => `
      <li class="${i <= S.step ? 'on' : ''} ${i === S.step ? 'current' : ''}" ${i === S.step ? 'aria-current="step"' : ''}>
        <span class="bk-track"><span class="bk-dot"></span><span class="bk-line ${i < S.step ? 'on' : ''}"></span></span>
        <span class="bk-lbl">${esc(t(k))}</span>
      </li>`).join('');
    elBody.innerHTML = S.loadingCat ? `<p class="bk-muted">${esc(t('modal.date.loading'))}</p>`
      : S.fatal ? renderFatal()
      : [renderService, renderStaff, renderDate, renderData, renderDone][S.step]();
    elFoot.innerHTML = renderFoot();
  }

  const arrow = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"></path></svg>';
  const alertBox = () => (S.alert ? `<p class="bk-alert" role="alert">${esc(S.alert)}</p>` : '');

  function errorBox(msg: string, retryAct: string) {
    return `<div class="bk-error" role="alert">
        <p>${esc(msg)}</p>
        <div class="bk-error-actions">
          <button type="button" class="bk-btn dark" data-act="${retryAct}">${esc(t('err.retry'))}</button>
          ${tel() ? `<a class="bk-btn" href="${tel()}">${esc(t('err.call'))}</a>` : ''}
        </div>
      </div>`;
  }
  function renderFatal() {
    return `<div class="bk-head"><h3>${esc(t('err.title'))}</h3></div>${errorBox(S.fatal, 'retry-open')}`;
  }

  function renderService() {
    const list = services();
    return `
      <div class="bk-head"><h3>${esc(t('modal.service.title'))}</h3><span class="bk-muted">${esc(t('modal.service.count', { n: list.length }))}</span></div>
      <div class="bk-svc-list bk-scroll" role="radiogroup" aria-label="${esc(t('modal.step.service'))}" tabindex="0">
        ${list.map((s) => `
          <button type="button" role="radio" aria-checked="${s.id === S.serviceId}" class="bk-opt ${s.id === S.serviceId ? 'sel' : ''}" data-act="service" data-val="${esc(s.id)}">
            <span class="bk-radio"></span>
            <span class="bk-grow"><span class="bk-strong">${esc(s.name[L] || s.name.es)}</span><span class="bk-muted">${s.duration} ${esc(t('services.min'))}</span></span>
            <span class="bk-strong bk-nowrap">${esc(t('services.from'))} ${s.price} €</span>
          </button>`).join('')}
      </div>`;
  }

  function renderStaff() {
    const pros = staffFor(cat, S.serviceId);
    const any = S.staffId === 'any';
    return `
      <div class="bk-head bk-head-left"><h3>${esc(t('modal.staff.title'))}</h3><span class="bk-chip">${esc(t('modal.staff.optional'))}</span></div>
      <button type="button" class="bk-opt bk-any ${any ? 'sel' : ''}" data-act="any">
        <span class="bk-grow"><span class="bk-strong" style="font-size:19px;font-weight:600">${esc(t('modal.staff.anyTitle'))}</span><span class="bk-muted">${esc(t('modal.staff.anyText'))}</span></span>
        <span class="bk-cta-mini">${esc(t('modal.staff.continue'))}${arrow}</span>
      </button>
      <span class="bk-muted">${esc(t('modal.staff.or'))}</span>
      <div class="bk-staff" role="radiogroup" aria-label="${esc(t('modal.step.staff'))}">
        ${pros.map((p) => `
          <button type="button" role="radio" aria-checked="${S.staffId === p.id}" class="bk-opt bk-pro ${S.staffId === p.id ? 'sel' : ''}" data-act="staff" data-val="${esc(p.id)}">
            <span class="bk-avatar">${esc(p.name.charAt(0))}</span>
            <span class="bk-strong">${esc(p.name)}</span>
            <span class="bk-muted">${esc(p.role[L] || p.role.es)}</span>
          </button>`).join('')}
      </div>`;
  }

  function renderDate() {
    const svc = service();
    const who = S.staffId === 'any' ? t('modal.done.any') : staffName(S.staffId);
    let times = '';
    if (!S.date && !S.slotsError) times = `<p class="bk-muted">${esc(t(S.days.length ? 'modal.date.choose' : 'modal.date.noDays'))}</p>`;
    else if (S.loadingSlots) times = `<p class="bk-muted">${esc(t('modal.date.loading'))}</p>`;
    else if (S.slotsError) times = errorBox(S.slotsError, 'retry-slots');
    else if (!S.slots.some((s) => s.staffId)) times = `<p class="bk-muted">${esc(t('modal.date.none'))}</p>`;
    else times = `<div class="bk-times" role="radiogroup" aria-label="${esc(t('modal.step.date'))}">${S.slots.map((s) =>
      s.staffId
        ? `<button type="button" role="radio" aria-checked="${s.time === S.time}" class="bk-time ${s.time === S.time ? 'sel' : ''}" data-act="time" data-val="${s.time}">${s.time}</button>`
        : `<button type="button" class="bk-time busy" disabled aria-label="${s.time}, ${esc(t('modal.date.busy'))}">${s.time}</button>`
    ).join('')}</div>`;
    return `
      <div class="bk-summary"><span class="bk-strong">${esc(svc.name[L] || svc.name.es)} · ${esc(who)}</span><span class="bk-muted">${svc.duration} ${esc(t('services.min'))} · ${esc(t('services.from'))} ${svc.price} €</span></div>
      <div class="bk-head"><h3>${esc(t('modal.date.title'))}</h3></div>
      <div class="bk-date-grid">
        ${renderCalendar()}
        <div class="bk-date-times">
          ${S.date ? `<p class="bk-strong bk-date-sel">${esc(formatDateLong(S.date, L))}</p>` : ''}
          ${alertBox()}
          ${times}
        </div>
      </div>`;
  }

  /** YYYY-MM desplazado n meses. */
  function shiftMonth(ym: string, n: number): string {
    const [y, m] = ym.split('-').map(Number);
    const d = new Date(Date.UTC(y, m - 1 + n, 1));
    return d.toISOString().slice(0, 7);
  }

  /** Calendario mensual (lunes → domingo). Solo se pueden pulsar los días con hueco posible según la hoja. */
  function renderCalendar() {
    const today = nowInSalon().date;
    const month = S.month || today.slice(0, 7);
    const minMonth = today.slice(0, 7);
    const maxMonth = (S.days[S.days.length - 1] ?? today).slice(0, 7);
    const [y, m] = month.split('-').map(Number);
    const total = new Date(Date.UTC(y, m, 0)).getUTCDate();
    const lead = (weekday(`${month}-01`) + 6) % 7; // huecos antes del día 1 (semana empezando en lunes)
    const bookable = new Set(S.days);
    const wd = t('wd.short').split('|');
    const head = [1, 2, 3, 4, 5, 6, 0].map((i) => `<span class="bk-cal-wd" aria-hidden="true">${esc(wd[i])}</span>`).join('');
    // Con Tab se entra en un solo día (el elegido o el primero disponible del mes); dentro, se mueve con las flechas.
    const inMonth = S.days.filter((d) => d.startsWith(month));
    const tabStop = inMonth.includes(S.date) ? S.date : inMonth[0];
    let cells = '<span></span>'.repeat(lead);
    for (let d = 1; d <= total; d++) {
      const date = `${month}-${String(d).padStart(2, '0')}`;
      const ok = bookable.has(date);
      const sel = date === S.date;
      const cls = ['bk-cal-day', sel ? 'sel' : '', date === today ? 'today' : '', ok ? '' : 'off'].join(' ');
      const attrs = ok ? `aria-pressed="${sel}" tabindex="${date === tabStop ? 0 : -1}"` : 'disabled';
      cells += `<button type="button" class="${cls}" data-act="day" data-val="${date}" aria-label="${esc(formatDateLong(date, L))}" ${attrs}>${d}</button>`;
    }
    const nav = (dir: -1 | 1) => {
      const off = dir < 0 ? month <= minMonth : month >= maxMonth;
      return `<button type="button" class="bk-cal-nav" data-act="month" data-val="${dir}" aria-label="${esc(t(dir < 0 ? 'modal.date.prev' : 'modal.date.next'))}" ${off ? 'disabled' : ''}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${dir < 0 ? 'M15 5l-7 7 7 7' : 'M9 5l7 7-7 7'}"></path></svg></button>`;
    };
    return `
      <div class="bk-cal">
        <div class="bk-cal-top">
          ${nav(-1)}
          <span class="bk-cal-title bk-cap" aria-live="polite">${esc(formatDayParts(`${month}-01`, L).monthLong)}</span>
          ${nav(1)}
        </div>
        <div class="bk-cal-grid">${head}${cells}</div>
      </div>`;
  }

  function field(name: string, label: string, type: string, auto: string, required = true) {
    const err = S.errors[name];
    const val = esc((S.form as unknown as Record<string, string>)[name] || '');
    return `<label class="bk-field ${err ? 'has-error' : ''} ${name === 'name' ? 'bk-full' : ''}">
      <span>${esc(label)}${required ? ' <span class="bk-req" aria-hidden="true">*</span>' : ''}</span>
      <input name="${name}" type="${type}" autocomplete="${auto}" value="${val}" ${required ? 'required aria-required="true"' : ''} ${err ? 'aria-invalid="true"' : ''}>
      ${err ? `<span class="bk-err">${esc(err)}</span>` : ''}
    </label>`;
  }

  function renderData() {
    const pErr = S.errors.privacy;
    return `
      <div class="bk-narrow">
        <div class="bk-head"><h3>${esc(t('modal.data.title'))}</h3><span class="bk-muted"><span class="bk-req">*</span> ${esc(t('modal.data.required'))}</span></div>
        ${alertBox()}
        <form class="bk-form" novalidate onsubmit="return false">
          ${field('name', t('modal.data.name'), 'text', 'name')}
          ${field('email', t('modal.data.email'), 'email', 'email')}
          ${field('phone', t('modal.data.phone'), 'tel', 'tel')}
          <label class="bk-field bk-full"><span>${esc(t('modal.data.notes'))}</span>
            <textarea name="notes" rows="3" placeholder="${esc(t('modal.data.notesPh'))}">${esc(S.form.notes)}</textarea>
          </label>
          <label class="bk-check bk-full ${pErr ? 'has-error' : ''}">
            <input type="checkbox" name="privacy" ${S.form.privacy ? 'checked' : ''} required>
            <span>${esc(t('modal.data.privacy1'))} <a href="${cfg.privacyPath}" target="_blank" rel="noopener">${esc(t('modal.data.privacy2'))}</a> <span class="bk-req" aria-hidden="true">*</span></span>
          </label>
          ${pErr ? `<span class="bk-err bk-full">${esc(pErr)}</span>` : ''}
        </form>
      </div>`;
  }

  function renderDone() {
    const b = S.booking!;
    const svc = service();
    const who = S.staffId === 'any' ? `${staffName(b.staffId)} <span class="bk-muted" style="font-size:20px">(${esc(t('modal.done.any'))})</span>` : esc(staffName(b.staffId));
    const manage = `${cfg.citaPath}?c=${encodeURIComponent(b.code)}&t=${encodeURIComponent(b.token)}`;
    return `
      <div class="bk-done">
        <span class="bk-check-icon"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4 10-10"></path></svg></span>
        <h3>${esc(t('modal.done.title'))}</h3>
        <p>${esc(t('modal.done.text'))}</p>
        ${b.discount ? `<p class="bk-discount">${esc(t('modal.done.discount', { n: b.discount }))}</p>` : ''}
        <dl>
          <div><dt>${esc(t('modal.done.service'))}</dt><dd>${esc(svc.name[L] || svc.name.es)} · ${esc(t('services.from'))} ${svc.price} €</dd></div>
          <div><dt>${esc(t('modal.done.staff'))}</dt><dd>${who}</dd></div>
          <div><dt>${esc(t('modal.done.when'))}</dt><dd>${esc(formatDateLong(b.date, L))} · ${b.time}</dd></div>
          <div><dt>${esc(t('modal.done.code'))}</dt><dd>${esc(b.code)}</dd></div>
        </dl>
        <a class="bk-link" href="${manage}">${esc(t('modal.done.manage'))}</a>
      </div>`;
  }

  function renderFoot() {
    const back = `<button type="button" class="bk-btn" data-nav="back">${esc(t('modal.back'))}</button>`;
    const info = `<span class="bk-muted">${esc(t('modal.footer', { n: S.step + 1 }))}</span>`;
    if (S.loadingCat || S.fatal) return `<span></span><button type="button" class="bk-btn" data-nav="close">${esc(t('modal.close'))}</button>`;
    switch (S.step) {
      case 0: return `${info}<button type="button" class="bk-btn dark" data-nav="next" ${S.serviceId ? '' : 'disabled'}>${esc(t('modal.next'))}</button>`;
      case 1: return `${back}<button type="button" class="bk-btn dark" data-nav="next">${esc(t('modal.next'))}</button>`;
      case 2: return `${back}<button type="button" class="bk-btn dark" data-nav="next" ${S.time ? '' : 'aria-disabled="true"'}>${esc(t('modal.next'))}</button>`;
      case 3: return `${back}<button type="button" class="bk-btn dark" data-nav="confirm" ${S.sending ? 'disabled' : ''}>${esc(S.sending ? t('modal.sending') : t('modal.confirm'))}</button>`;
      default: return `<button type="button" class="bk-btn" data-nav="close">${esc(t('modal.close'))}</button><button type="button" class="bk-btn dark" data-act-foot="ics">${esc(t('modal.done.calendar'))}</button>`;
    }
  }
  elFoot.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-act-foot="ics"]')) downloadIcs(S.booking!, service(), cat.salon.name, mapsQuery(cat), L);
  });
</script>

