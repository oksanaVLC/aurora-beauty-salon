---
import type { Lang } from '../lib/booking-core';
import { useTranslations } from '../i18n/ui';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<div class="hero-wrap">
  <img class="hero-bg" src="/images/interior-blur.jpg" alt="" aria-hidden="true" />
  <div class="hero-veil" aria-hidden="true"></div>
  <section id="inicio" class="container hero">
    <div class="hero-copy">
      <span class="eyebrow hero-in hero-eyebrow">{t('hero.eyebrow')}</span>
      <h1>
        <span class="hero-line"><span style="--d: .35s">{t('hero.title1')}</span></span>
        <span class="hero-line"><span style="--d: .55s">{t('hero.title2')}</span></span>
      </h1>
      <p class="hero-in" style="--d: .9s">{t('hero.text')}</p>
      <div class="hero-ctas hero-in" style="--d: 1.1s">
        <button type="button" class="btn btn-mint" data-book>
          {t('hero.ctaBook')}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"></path></svg>
        </button>
        <a href="#servicios" class="btn btn-white">{t('hero.ctaServices')}</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-arch hero-arch-in"><img src="/images/cliente-cafe.jpg" alt={t('hero.photoAlt')} fetchpriority="high" /></div>
      <!-- Regalo del descuento para clientes nuevos: se muestra solo si «descuento_nuevos» > 0 en la hoja -->
        <div class="promo" data-promo hidden>
          <div class="promo-card">
            <div class="promo-stripe-h" aria-hidden="true"></div>
            <div class="promo-stripe-v" aria-hidden="true"></div>
            <div class="promo-body">
              <span class="promo-eyebrow">{t('promo.eyebrow')}</span>
              <span class="promo-amount">−<span data-salon="discount"></span> %</span>
              <span class="promo-text">{t('promo.text')}</span>
              <button type="button" class="promo-btn" data-book>{t('promo.cta')}</button>
            </div>
          </div>
          <svg class="promo-bow" aria-hidden="true" width="92" height="92" viewBox="0 0 120 120">
            <defs><linearGradient id="bowP" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="rgb(255, 160, 204)"></stop><stop offset="0.35" stop-color="rgb(244, 118, 178)"></stop><stop offset="0.7" stop-color="rgb(222, 132, 214)"></stop><stop offset="1" stop-color="rgb(255, 172, 208)"></stop></linearGradient></defs>
            <g fill="url(#bowP)" stroke="#A3436F" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
              <path d="M55 46 C 46 62, 34 86, 22 110 L 31 103 L 35 116 C 46 94, 56 70, 61 50 Z"></path>
              <path d="M65 46 C 74 62, 86 86, 98 110 L 89 103 L 85 116 C 74 94, 64 70, 59 50 Z"></path>
              <path d="M56 36 C 44 22, 22 6, 11 13 C 2 20, 5 40, 13 50 C 26 53, 44 49, 56 44 Z"></path>
              <path d="M64 36 C 76 22, 98 6, 109 13 C 118 20, 115 40, 107 50 C 94 53, 76 49, 64 44 Z"></path>
              <path d="M51 31 Q 60 27 69 31 L 70 47 Q 60 52 50 47 Z"></path>
            </g>
            <g stroke="#A3436F" stroke-width="1.4" stroke-linecap="round" fill="none">
              <path d="M13 50 C 22 43, 32 40, 44 41"></path><path d="M107 50 C 98 43, 88 40, 76 41"></path>
              <path d="M55 36 L 55 43"></path><path d="M65 36 L 65 43"></path>
            </g>
          </svg>
        </div>
    </div>

    <!-- Solo en móvil / pantallas estrechas (cuando la foto queda debajo del texto) -->
    <div class="hero-cta-mobile">
      <button type="button" class="btn btn-mint" data-book>
        {t('hero.ctaBook')}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"></path></svg>
      </button>
    </div>
  </section>
</div>

<script>
  import { onSiteData } from '../lib/site-data';

  // Regalo: «tada» al aparecer y «wobble» (se agita de lado a lado) al pasar el ratón.
  const promo = document.querySelector<HTMLElement>('[data-promo]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let showPromo = (_show: boolean) => { if (promo) promo.hidden = !_show; };
  if (promo && !reduce) {
    const play = (name: string) => {
      promo.classList.remove('anim-tada', 'anim-wobble');
      void promo.offsetWidth; // reinicia la animación
      promo.classList.add(`anim-${name}`);
    };
    promo.addEventListener('animationend', (e) => e.target === promo && promo.classList.remove('anim-tada', 'anim-wobble'));
    showPromo = (show: boolean) => {
      const wasHidden = promo.hidden;
      promo.hidden = !show;
      if (show && wasHidden) setTimeout(() => play('tada'), 900);
    };
    promo.addEventListener('mouseenter', () => { if (!promo.classList.contains('anim-wobble')) play('wobble'); });
  }

  // El descuento sale de la hoja (Ajustes → descuento_nuevos). Sin datos, no hay regalo.
  onSiteData({ ok: (cat) => showPromo(cat.settings.newClientDiscount > 0), fail: () => showPromo(false) });
</script>
